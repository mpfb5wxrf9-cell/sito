# Config web del progetto Firebase reale (non sono segreti, ma tenerli
# fuori dal codice rende più facile cambiarli). Copia questo file in .env
# e incolla i valori da: Firebase Console -> Project settings -> General
# -> "Your apps" -> SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Metti a "false" per collegare l'app dev al progetto Firebase reale
# invece che agli emulatori locali.
VITE_USE_FIREBASE_EMULATOR=true
