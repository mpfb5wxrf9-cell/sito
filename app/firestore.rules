rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Lo staff usa un login singolo condiviso (email/password). I clienti
    // che ordinano dalla pagina pubblica (#/ordina) sono autenticati in modo
    // anonimo (invisibile a loro) solo per poter creare un ordine: non
    // devono poter leggere gli ordini altrui né toccare il menu.
    function isStaff() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isStaff();
    }
    match /orders/{orderId} {
      allow read, update, delete: if isStaff();
      allow create: if request.auth != null;
    }
  }
}
